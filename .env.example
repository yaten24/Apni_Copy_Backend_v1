# Copy to .env and fill in.
PORT=5100
HOST=127.0.0.1
# Comma-separated list of allowed browser origins
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=apnicopy
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES=7d
# Where worker photos and ID documents are stored (outside the web root)
UPLOAD_DIR=uploads
# The first admin account is created from these on first start
ADMIN_EMAIL=admin@apnicopy.in
ADMIN_PASSWORD=
